#!/bin/sh
# password-state expired|expiring|ok - IPA counterpart of password-state:
# reset IPA user bob to hunter2 (creating him on first use) and set when the
# password expires. IPA expires any password an admin sets, so a reset alone
# gives "expired".
set -e
# The container's boot never reaches the step that lifts pam_nologin's
# "System is booting up" block, so lift it here
rm -f /run/nologin
echo "$ADMIN_PASSWORD" | kinit admin >/dev/null
if ! ipa user-show bob >/dev/null 2>&1; then
    # Allow hunter2 (7 characters), back-to-back changes, and the failed
    # logins some tests make on purpose without locking bob out
    ipa pwpolicy-mod --minlength=7 --minlife=0 --maxfail=0 >/dev/null
    ipa user-add bob --first=Bob --last=Test >/dev/null
fi
echo hunter2 | ipa passwd bob >/dev/null
# Nothing on this host makes IPA users' home directories at login
[ -d /home/bob ] || { mkdir -p /home/bob && chown bob: /home/bob; } || true
case "$1" in
    expired)  ;;
    expiring) ipa user-mod bob --setattr "krbPasswordExpiration=$(date -u -d '+5 days' +%Y%m%d%H%M%SZ)" >/dev/null ;;
    ok)       ipa user-mod bob --setattr krbPasswordExpiration=20991231000000Z >/dev/null ;;
    *)        echo "usage: password-state expired|expiring|ok" >&2; exit 1 ;;
esac
kdestroy >/dev/null 2>&1 || true
# sssd caches logins; forget bob so the new state applies straight away
sss_cache -u bob 2>/dev/null || true
echo "bob (IPA): $1"
