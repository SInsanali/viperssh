#!/bin/sh
# password-state expired|expiring|ok - reset bob's password to hunter2 and
# set how it ages: expired forces a change at next login, expiring is 5 days
# from expiry (inside the 7-day warning window), ok never expires.
set -e
# (pwquality warns that hunter2 is short; root sets it anyway)
echo "bob:hunter2" | chpasswd 2>/dev/null
case "$1" in
    expired)  chage -d 0 -M 99999 bob ;;
    expiring) chage -d "$(date -d '25 days ago' +%F)" -M 30 -W 7 bob ;;
    ok)       chage -d "$(date +%F)" -M 99999 bob ;;
    *)        echo "usage: password-state expired|expiring|ok" >&2; exit 1 ;;
esac
echo "bob: $1"
